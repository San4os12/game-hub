{
  "id": "/game-hub/",
  "name": "GG Squad",
  "short_name": "GG Squad",
  "description": "Тиммейты, кланы, мини-игры и рекорды для геймеров",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0D0F14",
  "theme_color": "#0D0F14",
  "lang": "ru",
  "dir": "ltr",
  "categories": [
    "social",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
