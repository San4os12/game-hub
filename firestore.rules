rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function d() { return request.resource.data; }

    // Профиль и статус «в сети»: читают все, пишет только сам человек
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'nl', 'st', 'game', 'c', 'vote', 't', 'av', 'fav', 'sd', 'br', 'ba', 'cl', 'ct', 'xp', 'ach'])
        && d().nick is string && d().nick.size() <= 16
        && d().vote is string && d().vote.size() <= 40
        && (!('fav' in d()) || (d().fav is string && d().fav.size() <= 60))
        && d().t == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Общий чат и «Кто в игру?»
    match /messages/{id} {
      allow read: if true;
      allow create: if signedIn()
        && d().keys().hasOnly(['topic', 'uid', 'n', 'm', 'c', 't'])
        && d().uid == request.auth.uid
        && d().topic in ['chat', 'ping']
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() <= 200
        && d().t == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Личный список друзей: видит и меняет только владелец
    match /friends/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Таблица рекордов
    match /scores/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'c', 'av', 'r', 'a'])
        && d().nick is string && d().nick.size() <= 16
        && d().r is int && (d().r == 0 || (d().r >= 100 && d().r <= 5000))
        && d().a is int && d().a >= 0 && d().a <= 60;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Объявления «Ищу тиммейта»: одно на человека
    match /lfg/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'c', 'av', 'game', 'text', 't'])
        && d().nick is string && d().nick.size() <= 16
        && d().game is string && d().game.size() <= 20
        && d().text is string && d().text.size() > 0 && d().text.size() <= 120
        && d().t == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Личные сообщения: видят только отправитель и получатель
    match /dms/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && d().keys().hasOnly(['from', 'to', 'n', 'c', 'm', 't'])
        && d().from == request.auth.uid
        && d().to is string && d().to != d().from
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() > 0 && d().m.size() <= 300
        && d().t == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Облачное сохранение бэклога, гайда, дневника и профиля: только владелец, вошедший через Google
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Кланы: создать может любой; вступить/выйти/подать заявку — только сам за себя;
    // глава меняет настройки, принимает заявки, исключает и передаёт главенство
    match /clans/{id} {
      function old() { return resource.data; }
      function me() { return request.auth.uid; }
      function oreq() { return old().get('req', []); }
      function okFields() {
        return d().name is string && d().name.size() >= 3 && d().name.size() <= 20
          && d().tag is string && d().tag.size() >= 2 && d().tag.size() <= 4
          && d().emb is int
          && (!('desc' in d()) || (d().desc is string && d().desc.size() <= 150))
          && (!('game' in d()) || (d().game is string && d().game.size() <= 20))
          && (!('col' in d()) || d().col is int)
          && (!('open' in d()) || d().open is bool)
          && (!('max' in d()) || (d().max is int && d().max >= 5 && d().max <= 50))
          && (!('req' in d()) || (d().req is list && d().req.size() <= 50));
      }
      allow read: if true;
      allow create: if signedIn()
        && d().keys().hasOnly(['name', 'tag', 'emb', 'owner', 'members', 'mn', 't', 'desc', 'game', 'col', 'open', 'max', 'req'])
        && okFields()
        && d().owner == me()
        && d().members == [me()] && d().mn == 1
        && (!('req' in d()) || d().req.size() == 0)
        && d().t == request.time;
      allow update: if signedIn() && (
        // глава: настройки, заявки, исключение, передача главенства
        (me() == old().owner
          && d().diff(old()).affectedKeys().hasOnly(['name', 'tag', 'emb', 'desc', 'game', 'col', 'open', 'max', 'owner', 'members', 'mn', 'req'])
          && okFields()
          && d().mn == d().members.size()
          && d().members.size() <= d().get('max', 30)
          && d().owner in d().members
          && d().members.toSet().difference(old().members.toSet().union(oreq().toSet())).size() == 0
          && d().get('req', []).toSet().difference(oreq().toSet()).size() == 0)
        ||
        // вступить в открытый клан
        (!(me() in old().members)
          && old().get('open', true) == true
          && d().diff(old()).affectedKeys().hasOnly(['members', 'mn'])
          && d().members == old().members.concat([me()])
          && d().mn == d().members.size()
          && d().members.size() <= old().get('max', 30))
        ||
        // выйти (глава не выходит, а распускает клан или передаёт главенство)
        (me() in old().members && me() != old().owner
          && d().diff(old()).affectedKeys().hasOnly(['members', 'mn'])
          && d().mn == d().members.size()
          && d().members.size() == old().members.size() - 1
          && d().members.toSet() == old().members.toSet().difference([me()].toSet()))
        ||
        // подать заявку в закрытый клан
        (!(me() in old().members)
          && old().get('open', true) == false
          && !(me() in oreq())
          && d().diff(old()).affectedKeys().hasOnly(['req'])
          && d().req == oreq().concat([me()])
          && d().req.size() <= 50)
        ||
        // отменить свою заявку
        (me() in oreq()
          && d().diff(old()).affectedKeys().hasOnly(['req'])
          && d().req.size() == oreq().size() - 1
          && d().req.toSet() == oreq().toSet().difference([me()].toSet()))
      );
      allow delete: if signedIn() && me() == old().owner;
    }

    // Чат клана: писать могут только участники
    match /clanmsg/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && d().keys().hasOnly(['clan', 'uid', 'n', 'c', 'm', 't'])
        && d().uid == request.auth.uid
        && d().clan is string
        && request.auth.uid in get(/databases/$(database)/documents/clans/$(d().clan)).data.members
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() > 0 && d().m.size() <= 200
        && d().t == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Камень-ножницы-бумага: каждый делает только свой ход и только один раз
    match /rps/{id} {
      function rpsPlayer() {
        return signedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      }
      allow read, delete: if rpsPlayer();
      allow create: if signedIn()
        && d().keys().hasOnly(['a', 'b', 'an', 'bn', 'ma', 'mb', 't'])
        && d().a == request.auth.uid
        && d().b is string && d().b != d().a
        && d().an is string && d().an.size() <= 16
        && d().bn is string && d().bn.size() <= 16
        && d().ma == '' && d().mb == ''
        && d().t == request.time;
      allow update: if rpsPlayer() && d().t == request.time
        && (
          (request.auth.uid == resource.data.a && resource.data.ma == ''
            && d().diff(resource.data).affectedKeys().hasOnly(['ma', 't']) && d().ma in ['r', 'p', 's'])
          ||
          (request.auth.uid == resource.data.b && resource.data.mb == ''
            && d().diff(resource.data).affectedKeys().hasOnly(['mb', 't']) && d().mb in ['r', 'p', 's'])
        );
    }

    // Крестики-нолики: играют и видят только двое участников
    match /xo/{id} {
      function player() {
        return signedIn() && (request.auth.uid == resource.data.x || request.auth.uid == resource.data.o);
      }
      allow read, delete: if player();
      allow create: if signedIn()
        && d().keys().hasOnly(['x', 'o', 'xn', 'on', 'b', 'turn', 'w', 't'])
        && d().x == request.auth.uid
        && d().o is string && d().o != d().x
        && d().xn is string && d().xn.size() <= 16
        && d().on is string && d().on.size() <= 16
        && d().b == '---------' && d().turn == 'x' && d().w == ''
        && d().t == request.time;
      allow update: if player()
        && resource.data.w == ''
        && ((resource.data.turn == 'x' && request.auth.uid == resource.data.x)
            || (resource.data.turn == 'o' && request.auth.uid == resource.data.o))
        && d().keys().hasOnly(['x', 'o', 'xn', 'on', 'b', 'turn', 'w', 't'])
        && d().x == resource.data.x && d().o == resource.data.o
        && d().xn == resource.data.xn && d().on == resource.data.on
        && d().b is string && d().b.matches('[-xo]{9}')
        && d().turn in ['x', 'o'] && d().turn != resource.data.turn
        && d().w in ['', 'x', 'o', 'd']
        && d().t == request.time;
    }
  }
}
