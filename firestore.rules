rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function d() { return request.resource.data; }
    // цвет профиля: только значения из списка (20…33 — 14 цветов)
    function okC(x) { return x is int && x >= 20 && x <= 33; }
    // админы: документ admins/{uid} создаётся вручную в консоли Firebase
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // бан: bans/{uid} с полем until
    function notBanned() {
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until < request.time;
    }
    // заблокировал ли получатель отправителя
    function blockedBy(to) {
      return exists(/databases/$(database)/documents/blocks/$(to))
        && request.auth.uid in get(/databases/$(database)/documents/blocks/$(to)).data.ids;
    }

    // Профиль и статус «в сети»: читают все, пишет только сам человек
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'nl', 'st', 'game', 'c', 'vote', 't', 'av', 'fav', 'sd', 'br', 'ba', 'cl', 'ct', 'xp', 'ach', 'bn', 'fr', 'bio', 'pg', 'ps']) && (!('c' in d()) || okC(d().c))
        && d().nick is string && d().nick.size() <= 16
        && d().vote is string && d().vote.size() <= 40
        && (!('fav' in d()) || (d().fav is string && d().fav.size() <= 60))
        && (!('bio' in d()) || (d().bio is string && d().bio.size() <= 120))
        && (!('pg' in d()) || (d().pg is string && d().pg.size() <= 20))
        // защита от накрутки: опыт растёт не быстрее ~1800 в час (+1000 запас); админу можно
        && (!('xp' in d()) || (d().xp is int && (
              (resource == null && d().xp <= 3000)
              || (resource != null && d().xp <= resource.data.get('xp', 0) + 1000 + (request.time.toMillis() - resource.data.t.toMillis()) / 2000)
              || isAdmin())))
        && d().t == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Общий чат и «Кто в игру?»
    match /messages/{id} {
      allow read: if true;
      allow create: if signedIn()
        && d().keys().hasOnly(['topic', 'uid', 'n', 'm', 'c', 't']) && (!('c' in d()) || okC(d().c))
        && d().uid == request.auth.uid
        && d().topic in ['chat', 'ping']
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() <= 200
        && d().t == request.time
        && notBanned();
      allow update: if false;
      // своё, админ, или любое сообщение старше 7 дней (автоуборка)
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || resource.data.t < request.time - duration.value(7, 'd'));
    }

    // Личный список друзей: видит и меняет только владелец
    match /friends/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Таблица рекордов
    match /scores/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'c', 'av', 'r', 'a', 's', 'sx', 'w', 'wx', 't']) && (!('c' in d()) || okC(d().c))
        && (!('t' in d()) || d().t == request.time)
        && d().nick is string && d().nick.size() <= 16
        && d().r is int && (d().r == 0 || (d().r >= 100 && d().r <= 5000))
        && d().a is int && d().a >= 0 && d().a <= 60
        && (!('s' in d()) || (d().s is string && d().s.size() <= 8))
        && (!('sx' in d()) || (d().sx is int && d().sx >= 0 && d().sx <= 1000000))
        && (!('w' in d()) || (d().w is string && d().w.size() <= 8))
        && (!('wx' in d()) || (d().wx is int && d().wx >= 0 && d().wx <= 1000000))
        // защита от накрутки недели
        && (!('wx' in d()) || d().wx <= 3000 || isAdmin()
            || (resource != null && resource.data.get('w', '') == d().get('w', '')
                && d().wx <= resource.data.get('wx', 0) + 1000 + (request.time.toMillis() - resource.data.get('t', request.time).toMillis()) / 2000))
        // защита от накрутки сезона
        && (!('sx' in d()) || d().sx <= 3000 || isAdmin()
            || (resource != null && resource.data.get('s', '') == d().get('s', '')
                && d().sx <= resource.data.get('sx', 0) + 1000 + (request.time.toMillis() - resource.data.get('t', request.time).toMillis()) / 2000));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Объявления «Ищу тиммейта»: одно на человека
    match /lfg/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['nick', 'c', 'av', 'game', 'text', 't', 'pl', 'mic', 'lang', 'rank', 'need', 'h']) && (!('c' in d()) || okC(d().c))
        && d().nick is string && d().nick.size() <= 16
        && d().game is string && d().game.size() <= 20
        && d().text is string && d().text.size() > 0 && d().text.size() <= 120
        && (!('pl' in d()) || d().pl in ['pc', 'ps', 'xb', 'sw', 'mob'])
        && (!('mic' in d()) || d().mic is bool)
        && (!('lang' in d()) || (d().lang is string && d().lang.size() <= 5))
        && (!('rank' in d()) || (d().rank is string && d().rank.size() <= 20))
        && (!('need' in d()) || (d().need is int && d().need >= 1 && d().need <= 4))
        && (!('h' in d()) || d().h in [1, 3, 6])
        && d().t == request.time
        && notBanned();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Личные сообщения: видят только отправитель и получатель
    match /dms/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && d().keys().hasOnly(['from', 'to', 'n', 'c', 'm', 't']) && (!('c' in d()) || okC(d().c))
        && d().from == request.auth.uid
        && d().to is string && d().to != d().from
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() > 0 && d().m.size() <= 300
        && d().t == request.time
        && notBanned() && !blockedBy(d().to);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || isAdmin()
        || (resource.data.to == request.auth.uid && resource.data.t < request.time - duration.value(60, 'd')));
    }

    // Облачное сохранение бэклога, гайда, дневника и профиля: только владелец, вошедший через Google
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Кланы: создать может любой; вступить/выйти/подать заявку — только сам за себя;
    // глава меняет настройки, принимает заявки, исключает и передаёт главенство
    match /clans/{id} {
      function old() { return resource.data; }
      function me() { return request.auth.uid; }
      function oreq() { return old().get('req', []); }
      function okFields() {
        return d().name is string && d().name.size() >= 3 && d().name.size() <= 20
          && d().tag is string && d().tag.size() >= 2 && d().tag.size() <= 4
          && d().emb is int
          && (!('desc' in d()) || (d().desc is string && d().desc.size() <= 150))
          && (!('game' in d()) || (d().game is string && d().game.size() <= 20))
          && (!('col' in d()) || d().col is int)
          && (!('open' in d()) || d().open is bool)
          && (!('max' in d()) || (d().max is int && d().max >= 5 && d().max <= 50))
          && (!('req' in d()) || (d().req is list && d().req.size() <= 50));
      }
      allow read: if true;
      allow create: if signedIn()
        && d().keys().hasOnly(['name', 'tag', 'emb', 'owner', 'members', 'mn', 't', 'desc', 'game', 'col', 'open', 'max', 'req'])
        && okFields()
        && d().owner == me()
        && d().members == [me()] && d().mn == 1
        && (!('req' in d()) || d().req.size() == 0)
        && d().t == request.time
        && notBanned();
      allow update: if signedIn() && (
        // глава: настройки, заявки, исключение, передача главенства
        (me() == old().owner
          && d().diff(old()).affectedKeys().hasOnly(['name', 'tag', 'emb', 'desc', 'game', 'col', 'open', 'max', 'owner', 'members', 'mn', 'req'])
          && okFields()
          && d().mn == d().members.size()
          && d().members.size() <= d().get('max', 30)
          && d().owner in d().members
          && d().members.toSet().difference(old().members.toSet().union(oreq().toSet())).size() == 0
          && d().get('req', []).toSet().difference(oreq().toSet()).size() == 0)
        ||
        // вступить в открытый клан
        (!(me() in old().members)
          && old().get('open', true) == true
          && d().diff(old()).affectedKeys().hasOnly(['members', 'mn'])
          && d().members == old().members.concat([me()])
          && d().mn == d().members.size()
          && d().members.size() <= old().get('max', 30))
        ||
        // выйти (глава не выходит, а распускает клан или передаёт главенство)
        (me() in old().members && me() != old().owner
          && d().diff(old()).affectedKeys().hasOnly(['members', 'mn'])
          && d().mn == d().members.size()
          && d().members.size() == old().members.size() - 1
          && d().members.toSet() == old().members.toSet().difference([me()].toSet()))
        ||
        // подать заявку в закрытый клан
        (!(me() in old().members)
          && old().get('open', true) == false
          && !(me() in oreq())
          && d().diff(old()).affectedKeys().hasOnly(['req'])
          && d().req == oreq().concat([me()])
          && d().req.size() <= 50)
        ||
        // участник приносит клану опыт (не больше 200 за раз) и очки недельной войны
        (me() in old().members
          && d().diff(old()).affectedKeys().hasOnly(['xp', 'wxp', 'wk', 'lt'])
          && (!('lt' in d()) || d().lt == request.time)
          && (old().get('lt', null) == null || request.time > old().lt + duration.value(50, 's'))
          && d().xp is int && d().xp > old().get('xp', 0) && d().xp <= old().get('xp', 0) + 200
          && d().wk is string && d().wk.size() <= 10
          && d().wxp is int && d().wxp > 0
          && ((d().wk == old().get('wk', '') && d().wxp <= old().get('wxp', 0) + 200)
              || (d().wk != old().get('wk', '') && d().wxp <= 200)))
        ||
        // отменить свою заявку
        (me() in oreq()
          && d().diff(old()).affectedKeys().hasOnly(['req'])
          && d().req.size() == oreq().size() - 1
          && d().req.toSet() == oreq().toSet().difference([me()].toSet()))
      );
      allow delete: if signedIn() && (me() == old().owner || isAdmin());
    }

    // Чат клана: писать могут только участники
    match /clanmsg/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && d().keys().hasOnly(['clan', 'uid', 'n', 'c', 'm', 't']) && (!('c' in d()) || okC(d().c))
        && d().uid == request.auth.uid
        && d().clan is string
        && request.auth.uid in get(/databases/$(database)/documents/clans/$(d().clan)).data.members
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() > 0 && d().m.size() <= 200
        && d().t == request.time
        && notBanned();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || resource.data.t < request.time - duration.value(30, 'd'));
    }

    // Камень-ножницы-бумага: каждый делает только свой ход и только один раз
    match /rps/{id} {
      function rpsPlayer() {
        return signedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      }
      allow read, delete: if rpsPlayer();
      allow create: if signedIn()
        && d().keys().hasOnly(['a', 'b', 'an', 'bn', 'ma', 'mb', 't'])
        && d().a == request.auth.uid
        && d().b is string && d().b != d().a
        && d().an is string && d().an.size() <= 16
        && d().bn is string && d().bn.size() <= 16
        && d().ma == '' && d().mb == ''
        && d().t == request.time
        && !blockedBy(d().b);
      allow update: if rpsPlayer() && d().t == request.time
        && (
          (request.auth.uid == resource.data.a && resource.data.ma == ''
            && d().diff(resource.data).affectedKeys().hasOnly(['ma', 't']) && d().ma in ['r', 'p', 's'])
          ||
          (request.auth.uid == resource.data.b && resource.data.mb == ''
            && d().diff(resource.data).affectedKeys().hasOnly(['mb', 't']) && d().mb in ['r', 'p', 's'])
        );
    }

    // Крестики-нолики: играют и видят только двое участников
    match /xo/{id} {
      function player() {
        return signedIn() && (request.auth.uid == resource.data.x || request.auth.uid == resource.data.o);
      }
      allow read, delete: if player();
      allow create: if signedIn()
        && d().keys().hasOnly(['x', 'o', 'xn', 'on', 'b', 'turn', 'w', 't'])
        && d().x == request.auth.uid
        && d().o is string && d().o != d().x
        && d().xn is string && d().xn.size() <= 16
        && d().on is string && d().on.size() <= 16
        && d().b == '---------' && d().turn == 'x' && d().w == ''
        && d().t == request.time
        && !blockedBy(d().o);
      allow update: if player()
        && resource.data.w == ''
        && ((resource.data.turn == 'x' && request.auth.uid == resource.data.x)
            || (resource.data.turn == 'o' && request.auth.uid == resource.data.o))
        && d().keys().hasOnly(['x', 'o', 'xn', 'on', 'b', 'turn', 'w', 't'])
        && d().x == resource.data.x && d().o == resource.data.o
        && d().xn == resource.data.xn && d().on == resource.data.on
        && d().b is string && d().b.matches('[-xo]{9}')
        && d().turn in ['x', 'o'] && d().turn != resource.data.turn
        && d().w in ['', 'x', 'o', 'd']
        && d().t == request.time;
    }

    // Свой баннер профиля: только картинка webp/jpeg/png до ~280 КБ, пишет только владелец
    match /banners/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['img', 't'])
        && d().img is string && d().img.size() < 280000
        && (d().img.matches('data:image/webp;base64,[A-Za-z0-9+/=]+')
            || d().img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
            || d().img.matches('data:image/png;base64,[A-Za-z0-9+/=]+'))
        && d().t == request.time
        && notBanned();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Чёрный список: кого человек заблокировал (используется правилами выше)
    match /blocks/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['ids']) && d().ids is list && d().ids.size() <= 200;
    }

    // Заявки в друзья: id = отправитель_получатель
    match /freq/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && d().keys().hasOnly(['from', 'to', 'fn', 'st', 't'])
        && d().from == request.auth.uid
        && d().to is string && d().to != d().from
        && id == d().from + '_' + d().to
        && d().fn is string && d().fn.size() <= 16
        && d().st == 'p'
        && d().t == request.time
        && notBanned() && !blockedBy(d().to);
      allow update: if signedIn() && request.auth.uid == resource.data.to
        && d().diff(resource.data).affectedKeys().hasOnly(['st']) && d().st == 'a';
      allow delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Жалобы: отправить может любой, читают и закрывают только админы
    match /reports/{id} {
      allow create: if signedIn()
        && d().keys().hasOnly(['by', 'target', 'kind', 'ref', 'text', 'reason', 't'])
        && d().by == request.auth.uid
        && d().target is string && d().target.size() <= 64
        && d().kind in ['msg', 'user', 'clan', 'lfg']
        && d().ref is string && d().ref.size() <= 120
        && d().text is string && d().text.size() <= 300
        && d().reason is string && d().reason.size() <= 10
        && d().t == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Баны: видят все (чтобы приложение показало предупреждение), выдают только админы
    match /bans/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && d().keys().hasOnly(['until', 'reason', 'by'])
        && d().until is timestamp && d().reason is string && d().reason.size() <= 80;
      allow delete: if isAdmin();
    }

    // Список админов: каждый может проверить только себя; меняется только в консоли
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Отклики «Я в деле!» на объявления: id = автор_откликнувшийся
    match /lfgr/{id} {
      allow read: if true;
      allow create: if signedIn()
        && d().keys().hasOnly(['to', 'from', 'n', 'av', 'c', 't']) && (!('c' in d()) || okC(d().c))
        && d().from == request.auth.uid
        && d().to is string && d().to != d().from
        && id == d().to + '_' + d().from
        && d().n is string && d().n.size() <= 16
        && d().t == request.time
        && notBanned() && !blockedBy(d().to);
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to || isAdmin());
    }

    // Приглашения по ссылке: новичок записывает, кто его позвал (один раз)
    match /refs/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.by);
      allow create: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['by', 'n', 't'])
        && d().by is string && d().by != uid && d().by.size() <= 64
        && d().n is string && d().n.size() <= 16
        && d().t == request.time
        && exists(/databases/$(database)/documents/presence/$(d().by));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Игровые аккаунты в профиле (Steam, Riot ID, ранги…): читают все, меняет только владелец
    match /accs/{uid} {
      function okA(k) { return !(k in d().a) || (d().a[k] is string && d().a[k].size() > 0 && d().a[k].size() <= 32); }
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['a', 't'])
        && d().a is map && d().a.size() <= 16
        && d().a.keys().hasOnly(['steam', 'riot', 'epic', 'bnet', 'psn', 'xbox', 'sw', 'ea', 'mc', 'rbx', 'ds', 'cs', 'val', 'dota', 'lol'])
        && okA('steam') && okA('riot') && okA('epic') && okA('bnet') && okA('psn') && okA('xbox') && okA('sw') && okA('ea')
        && okA('mc') && okA('rbx') && okA('ds') && okA('cs') && okA('val') && okA('dota') && okA('lol')
        && d().t == request.time
        && notBanned();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Репутация: оценка тиммейта, id = кто_кого. Одна на пару, можно изменить или снять
    match /endo/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && d().keys().hasOnly(['from', 'to', 'k', 't'])
        && d().from == request.auth.uid
        && d().to is string && d().to != d().from && d().to.size() <= 64
        && id == d().from + '_' + d().to
        && d().k is list && d().k.size() >= 1 && d().k.size() <= 3
        && d().k.hasOnly(['good', 'skill', 'fun'])
        && d().k.toSet().size() == d().k.size()
        && d().t == request.time
        && notBanned() && !blockedBy(d().to);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    // Пати-лобби: id = создатель. Игроки сами занимают свободные места и выходят, создатель может убрать игрока
    match /party/{id} {
      function old() { return resource.data; }
      function me() { return request.auth.uid; }
      function mem(m, u) {
        return m[u] is map && m[u].keys().hasOnly(['n', 'av', 'c', 'j', 'r'])
          && (!('r' in m[u]) || m[u].r is bool)
          && m[u].n is string && m[u].n.size() <= 16
          && (!('av' in m[u]) || m[u].av is int) && (!('c' in m[u]) || okC(m[u].c)) && (!('j' in m[u]) || m[u].j is int);
      }
      allow read: if true;
      // создатель: создать или изменить своё пати (сам всегда внутри, чужих добавить не может)
      allow create, update: if signedIn() && id == me()
        && d().keys().hasOnly(['o', 'n', 'game', 'text', 'sz', 'h', 'mic', 'm', 't', 'u', 'go', 'gt'])
        && (!('go' in d()) || (d().go is string && d().go.size() <= 160))
        && (!('gt' in d()) || d().gt == request.time || (resource != null && 'gt' in old() && d().gt == old().gt))
        && d().o == me()
        && d().n is string && d().n.size() <= 16
        && d().game is string && d().game.size() <= 20
        && d().text is string && d().text.size() <= 80
        && d().sz in [2, 3, 4, 5, 6, 10]
        && d().h in [1, 3, 6]
        && d().mic is bool
        && d().m is map && me() in d().m && d().m.size() <= d().sz
        && mem(d().m, me())
        && d().u == request.time
        && ((resource == null && d().t == request.time)
            || (resource != null
                && (d().t == old().t || d().t == request.time)
                && d().m.diff(old().get('m', {})).addedKeys().hasOnly([me()])
                && d().m.diff(old().get('m', {})).changedKeys().hasOnly([me()])))
        && notBanned();
      // игрок: занять свободное место или выйти
      allow update: if signedIn() && id != me()
        && d().diff(old()).affectedKeys().hasOnly(['m', 'u'])
        && d().u == request.time
        && d().m is map
        && d().m.diff(old().m).affectedKeys().hasOnly([me()])
        && (
          (!(me() in old().m) && me() in d().m && mem(d().m, me())
            && d().m.size() <= old().sz
            && old().t > request.time - duration.value(old().h, 'h')
            && notBanned() && !blockedBy(old().o))
          ||
          (me() in old().m && !(me() in d().m))
          ||
          (me() in old().m && me() in d().m && mem(d().m, me()) && d().m.size() == old().m.size())
        );
      allow delete: if signedIn() && (id == me() || isAdmin() || old().t < request.time - duration.value(7, 'h'));
    }

    // Чат пати: пишут только участники пати; хранится до 1 дня
    match /pmsg/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && d().keys().hasOnly(['p', 'uid', 'n', 'c', 'm', 't']) && (!('c' in d()) || okC(d().c))
        && d().uid == request.auth.uid
        && d().p is string && d().p.size() <= 64
        && request.auth.uid in get(/databases/$(database)/documents/party/$(d().p)).data.m
        && d().n is string && d().n.size() <= 16
        && d().m is string && d().m.size() > 0 && d().m.size() <= 200
        && d().t == request.time
        && notBanned();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.p == request.auth.uid || isAdmin()
        || resource.data.t < request.time - duration.value(1, 'd'));
    }

    // Запись в тестеры Google Play: почту видят только сам игрок и админ
    match /testers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['e', 'n', 'dv', 'l', 't'])
        && d().e is string && d().e.size() >= 6 && d().e.size() <= 80 && d().e.matches('[^@ ]+@[^@ ]+[.][a-z]{2,12}')
        && d().n is string && d().n.size() <= 16
        && d().dv in ['a', 'i', 'd']
        && d().l is string && d().l.size() <= 3
        && d().t == request.time;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Настройки приложения (ссылка на тест в Google Play): читают все, меняет только админ
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && d().keys().hasOnly(['test', 't'])
        && (!('test' in d()) || (d().test is string && d().test.size() <= 200 && d().test.matches('https://play[.]google[.]com/.*')));
      allow delete: if isAdmin();
    }

    // Общая статистика: когда игрок впервые зашёл, язык и тип устройства. Видит только админ
    match /joined/{uid} {
      function okJ() {
        return d().l in ['ru', 'en', 'cs'] && d().dv in ['a', 'i', 'd'] && d().pw is bool && d().tw is bool;
      }
      // откуда пришёл (короткая метка) и шаги новичка — только «true»
      function okS() { return !('s' in d()) || (d().s is string && d().s.size() <= 8); }
      function okF() {
        return (!('a1' in d()) || d().a1 == true) && (!('a2' in d()) || d().a2 == true)
          && (!('a3' in d()) || d().a3 == true) && (!('a4' in d()) || d().a4 == true)
          && (!('a5' in d()) || d().a5 == true);
      }
      allow read: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['t', 'l', 'dv', 'pw', 'tw', 's']) && okJ() && okS() && d().t == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && d().diff(resource.data).affectedKeys().hasOnly(['l', 'dv', 'pw', 'tw', 'a1', 'a2', 'a3', 'a4', 'a5', 'ta', 'td'])
        && okJ() && okS() && okF()
        && (!('ta' in d()) || (d().ta is string && d().ta.size() <= 10))
        && (!('td' in d()) || (d().td is int && d().td >= 0 && d().td <= resource.data.get('td', 0) + 1));
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Сборы на время: id = создатель. Остальные могут только записаться/выписаться сами
    match /meet/{id} {
      function ent(e) {
        return e is map && e.keys().hasOnly(['n', 'av', 'c']) && e.n is string && e.n.size() <= 16
          && (!('av' in e) || e.av is int) && (!('c' in e) || okC(e.c));
      }
      allow read: if true;
      allow create, update: if signedIn() && id == request.auth.uid
        && d().keys().hasOnly(['o', 'n', 'c', 'av', 'g', 'at', 'rp', 'y', 't', 'rm', 'st', 'pm'])
        && d().o == id && d().n is string && d().n.size() <= 16 && d().g is string && d().g.size() <= 20
        && d().at is timestamp && d().at > request.time - duration.value(3, 'h') && d().at < request.time + duration.value(8, 'd')
        && d().rp is bool && d().y is map && d().y.size() <= 30 && ent(d().y[id])
        && (!('c' in d()) || okC(d().c)) && (!('av' in d()) || d().av is int)
        && d().t == request.time;
      allow update: if signedIn() && id != request.auth.uid
        && d().diff(resource.data).affectedKeys().hasOnly(['y'])
        && d().y.diff(resource.data.y).affectedKeys().hasOnly([request.auth.uid])
        && d().y.size() <= 30
        && (!(request.auth.uid in d().y) || ent(d().y[request.auth.uid]));
      allow delete: if signedIn() && (id == request.auth.uid || isAdmin());
    }

    // Когда игрок вернулся в приложение — по этому сервер шлёт «друг в сети». Читает только сервер
    match /seen/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['t', 'n']) && d().t == request.time
        && ((resource == null && !('n' in d())) || (resource != null && d().get('n', null) == resource.data.get('n', null)));
    }

    // Напоминание тестеру от админа (сервер отправит пуш и удалит)
    // «Просмотрено» в личке: r прочитал переписку с o. Видят только эти двое.
    match /dmread/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.r || request.auth.uid == resource.data.o);
      allow create, update: if signedIn() && d().keys().hasOnly(['r', 'o', 't'])
        && d().r == request.auth.uid && d().o is string && d().o.size() > 0 && d().o.size() <= 40 && d().o != d().r
        && id == d().r + '_' + d().o && d().t == request.time;
      allow delete: if signedIn() && (request.auth.uid == resource.data.r || request.auth.uid == resource.data.o);
    }

    // «печатает…» в личке: r набирает сообщение для o
    match /dmtype/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.r || request.auth.uid == resource.data.o);
      allow create, update: if signedIn() && d().keys().hasOnly(['r', 'o', 't'])
        && d().r == request.auth.uid && d().o is string && d().o.size() > 0 && d().o.size() <= 40 && d().o != d().r
        && id == d().r + '_' + d().o && d().t == request.time;
      allow delete: if signedIn() && (request.auth.uid == resource.data.r || request.auth.uid == resource.data.o);
    }

    match /nudge/{id} {
      allow read: if false;
      allow create: if isAdmin() && d().keys().hasOnly(['to', 'from', 'k', 't'])
        && d().from == request.auth.uid && d().to is string && d().to.size() <= 40 && d().k in ['test'] && d().t == request.time;
    }

    // Подписка на пуш-уведомления: видит и меняет только сам игрок (сервер читает в обход правил)
    match /push/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['tokens', 'prefs', 'lang', 'gr', 'gd', 't'])
        && d().tokens is list && d().tokens.size() <= 10
        && (!('prefs' in d()) || d().prefs is map)
        && (!('lang' in d()) || (d().lang is string && d().lang.size() <= 3))
        && (!('gr' in d()) || d().gr is bool)
        && (!('gd' in d()) || (d().gd is string && d().gd.size() <= 12))
        && d().t == request.time;
    }
  }
}
